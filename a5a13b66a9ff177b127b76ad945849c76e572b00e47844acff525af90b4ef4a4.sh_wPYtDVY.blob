public sealed class ValueCatalog
{
	public readonly List<CatalogItem> Items = new List<CatalogItem>();

	private readonly Dictionary<string, CatalogItem> byId = new Dictionary<string, CatalogItem>(StringComparer.Ordinal);

	private Dictionary<string, double> prices;

	private readonly Dictionary<string, Recipe> recipes = new Dictionary<string, Recipe>();

	private readonly Dictionary<string, double> computed = new Dictionary<string, double>();

	private readonly Dictionary<string, string> reasons = new Dictionary<string, string>();

	private readonly string folder;

	private readonly ManualLogSource log;

	private readonly double markup;

	private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

	public string PricePath => Path.Combine(folder, "ItemValues.json");

	public ValueCatalog(string folder, double markup, ManualLogSource log)
	{
		this.folder = folder;
		this.markup = markup;
		this.log = log;
	}

	public void Build()
	{
		//IL_01b5: Unknown result type (might be due to invalid IL or missing references)
		//IL_01c3: Unknown result type (might be due to invalid IL or missing references)
		//IL_01ca: Invalid comparison between Unknown and I4
		Items.Clear();
		byId.Clear();
		recipes.Clear();
		computed.Clear();
		reasons.Clear();
		prices = Defaults();
		Directory.CreateDirectory(folder);
		if (File.Exists(PricePath))
		{
			foreach (KeyValuePair<string, double> item in JsonConvert.DeserializeObject<Dictionary<string, double>>(File.ReadAllText(PricePath)) ?? throw new InvalidDataException("ItemValues.json must contain an object of prefab IDs and prices."))
			{
				if (item.Value < 0.0 || double.IsInfinity(item.Value) || double.IsNaN(item.Value))
				{
					throw new InvalidDataException("Invalid price for " + item.Key);
				}
				prices[item.Key] = item.Value;
			}
		}
		foreach (GameObject item2 in ObjectDB.instance.m_items)
		{
			if ((Object)(object)item2 == (Object)null)
			{
				continue;
			}
			ItemDrop component = item2.GetComponent<ItemDrop>();
			if (!((Object)(object)component == (Object)null) && component.m_itemData != null)
			{
				ItemData itemData = component.m_itemData;
				if (itemData.m_shared != null && !string.IsNullOrEmpty(itemData.m_shared.m_name) && itemData.m_shared.m_icons != null && itemData.m_shared.m_icons.Length != 0 && !((Object)(object)itemData.m_shared.m_icons[0] == (Object)null) && (int)itemData.m_shared.m_itemType != 0 && (int)itemData.m_shared.m_itemType != 10 && !byId.ContainsKey(((Object)item2).name))
				{
					CatalogItem catalogItem = new CatalogItem
					{
						Id = ((Object)item2).name,
						Prefab = item2,
						Template = itemData
					};
					byId.Add(catalogItem.Id, catalogItem);
				}
			}
		}
		foreach (Recipe recipe in ObjectDB.instance.m_recipes)
		{
			if (!((Object)(object)recipe == (Object)null) && recipe.m_enabled && !((Object)(object)recipe.m_item == (Object)null) && recipe.m_amount > 0)
			{
				string name = ((Object)((Component)recipe.m_item).gameObject).name;
				if (!recipes.ContainsKey(name))
				{
					recipes[name] = recipe;
				}
			}
		}
		foreach (CatalogItem value in byId.Values)
		{
			value.Value = Math.Round(Resolve(value.Id, new HashSet<string>()), 4);
			value.Reason = (reasons.ContainsKey(value.Id) ? reasons[value.Id] : "Configured value");
			if (!prices.ContainsKey(value.Id))
			{
				prices[value.Id] = value.Value;
			}
			if (value.Value > 0.0)
			{
				Items.Add(value);
			}
		}
		Items.Sort((CatalogItem a, CatalogItem b) => string.Compare(a.Name, b.Name, StringComparison.CurrentCultureIgnoreCase));
		AtomicWrite(PricePath, JsonConvert.SerializeObject((object)prices.OrderBy((KeyValuePair<string, double> p) => p.Key).ToDictionary((KeyValuePair<string, double> p) => p.Key, (KeyValuePair<string, double> p) => p.Value), (Formatting)1));
		ExportCsv();
		log.LogInfo((object)("ItemUpgrader: valued " + Items.Count + " items; prices at " + PricePath));
	}

	public CatalogItem Find(string id)
	{
		if (id == null || !byId.TryGetValue(id, out var value) || !(value.Value > 0.0))
		{
			return null;
		}
		return value;
	}

	public CatalogItem Find(ItemData item)
	{
		if (item != null && !((Object)(object)item.m_dropPrefab == (Object)null))
		{
			return Find(((Object)item.m_dropPrefab).name);
		}
		return null;
	}

	public double StakeValue(ItemData item, int count)
	{
		CatalogItem catalogItem = Find(item);
		if (catalogItem == null || count < 1)
		{
			return 0.0;
		}
		double num = catalogItem.Value;
		if (recipes.TryGetValue(catalogItem.Id, out var value) && item.m_quality > 1)
		{
			for (int i = 2; i <= Math.Min(item.m_quality, 100); i++)
			{
				double num2 = IngredientCost(value, i, new HashSet<string>());
				num += num2 * markup;
			}
		}
		else if (item.m_quality > 1)
		{
			num *= 1.0 + 0.35 * (double)(Math.Min(item.m_quality, 100) - 1);
		}
		if (item.m_shared.m_useDurability)
		{
			float maxDurability = item.GetMaxDurability();
			if (maxDurability > 0f)
			{
				num *= 0.25 + 0.75 * (double)Mathf.Clamp01(item.m_durability / maxDurability);
			}
		}
		return num * (double)count;
	}

	private double Resolve(string id, HashSet<string> visiting)
	{
		if (prices.TryGetValue(id, out var value))
		{
			reasons[id] = "Assigned resource / configured value";
			return value;
		}
		if (computed.TryGetValue(id, out value))
		{
			return value;
		}
		if (!visiting.Add(id))
		{
			return Fallback(id);
		}
		if (recipes.TryGetValue(id, out var value2))
		{
			double num = IngredientCost(value2, 1, visiting);
			if (num > 0.0)
			{
				value = (num * markup + StationCost(value2)) / (double)Math.Max(1, value2.m_amount);
				reasons[id] = "Recipe ingredients + " + ((markup - 1.0) * 100.0).ToString("0", Inv) + "% labor + station effort / recipe yield";
			}
			else
			{
				value = Fallback(id);
				reasons[id] = "Estimated: item type, tier and statistics (no priced recipe)";
			}
		}
		else
		{
			value = Fallback(id);
			reasons[id] = "Estimated: item type, tier and statistics (no priced recipe)";
		}
		visiting.Remove(id);
		computed[id] = value;
		return value;
	}

	private double IngredientCost(Recipe recipe, int quality, HashSet<string> visiting)
	{
		double num = 0.0;
		double num2 = double.MaxValue;
		if (recipe.m_resources == null)
		{
			return 0.0;
		}
		Requirement[] resources = recipe.m_resources;
		foreach (Requirement val in resources)
		{
			if (val == null || (Object)(object)val.m_resItem == (Object)null)
			{
				continue;
			}
			int amount = val.GetAmount(quality);
			if (amount > 0)
			{
				double num3 = Resolve(((Object)((Component)val.m_resItem).gameObject).name, visiting) * (double)amount;
				if (num3 > 0.0)
				{
					num2 = Math.Min(num2, num3);
				}
				num += num3;
			}
		}
		if (!recipe.m_requireOnlyOneIngredient)
		{
			return num;
		}
		if (num2 != double.MaxValue)
		{
			return num2;
		}
		return 0.0;
	}

	private static double StationCost(Recipe recipe)
	{
		string text = (((Object)(object)recipe.m_craftingStation == (Object)null) ? "" : ((Object)((Component)recipe.m_craftingStation).gameObject).name.ToLowerInvariant());
		double num = 2.0;
		if (text.Contains("workbench"))
		{
			num = 5.0;
		}
		if (text.Contains("cauldron"))
		{
			num = 12.0;
		}
		if (text.Contains("forge"))
		{
			num = 25.0;
		}
		if (text.Contains("blackforge"))
		{
			num = 90.0;
		}
		if (text.Contains("mage"))
		{
			num = 110.0;
		}
		if (text.Contains("north") || text.Contains("ice"))
		{
			num = 180.0;
		}
		return num * (double)Math.Max(1, recipe.m_minStationLevel);
	}

	private double Fallback(string id)
	{
		if (!byId.TryGetValue(id, out var value))
		{
			return 10.0;
		}
		SharedData shared = value.Template.m_shared;
		string name = id.ToLowerInvariant();
		int num = Math.Max(1, Math.Min(8, shared.m_toolTier + 1));
		string[][] array = new string[8][]
		{
			new string[4] { "flint", "leather", "rag", "wood" },
			new string[4] { "bronze", "troll", "copper", "tin" },
			new string[4] { "iron", "root", "draugr", "abomination" },
			new string[5] { "silver", "wolf", "fenris", "mountain", "drake" },
			new string[5] { "blackmetal", "padded", "lox", "fuling", "goblin" },
			new string[7] { "carapace", "mist", "seeker", "eitr", "dvergr", "jotun", "jotunn" },
			new string[8] { "ash", "flametal", "morgen", "asksvin", "volture", "charred", "fader", "dvergrash" },
			new string[8] { "north", "frost", "glacier", "ice", "winter", "boreal", "jormun", "nidhogg" }
		};
		for (int i = 0; i < array.Length; i++)
		{
			if (array[i].Any((string k) => name.Contains(k)))
			{
				num = Math.Max(num, i + 1);
			}
		}
		double num2 = (new double[8] { 1.0, 3.0, 7.0, 12.0, 20.0, 35.0, 60.0, 95.0 })[num - 1];
		switch (((object)Unsafe.As<ItemType, ItemType>(ref shared.m_itemType)/*cast due to .constrained prefix*/).ToString())
		{
		case "Trophy":
			return 80.0 * num2;
		case "Fish":
			return 18.0 * num2;
		case "Consumable":
			return Math.Max(8.0 * num2, (double)(shared.m_food + shared.m_foodStamina + 2f * shared.m_foodEitr) * 0.6 * (double)Math.Max(1f, shared.m_foodBurnTime / 1200f));
		case "Ammo":
		case "AmmoNonEquipable":
			return Math.Max(1.0, 2.0 * num2);
		case "Material":
			return Math.Max(5.0 * num2, shared.m_value);
		case "Trinket":
			return 150.0 * num2;
		case "Misc":
			return Math.Max(25.0 * num2, shared.m_value);
		case "Utility":
			return Math.Max(150.0 * num2, shared.m_value);
		default:
			return Math.Max(75.0 * num2, shared.m_armor * 20f + shared.m_blockPower * 5f + ((DamageTypes)(ref shared.m_damages)).GetTotalDamage() * 8f);
		}
	}

	private void ExportCsv()
	{
		StringBuilder stringBuilder = new StringBuilder("Prefab;Name;Value;Category;Basis\n");
		foreach (CatalogItem item in Items.OrderBy((CatalogItem i) => i.Id))
		{
			stringBuilder.Append(Csv(item.Id)).Append(';').Append(Csv(item.Name))
				.Append(';')
				.Append(item.Value.ToString("0.####", Inv))
				.Append(';')
				.Append(Csv(((object)Unsafe.As<ItemType, ItemType>(ref item.Template.m_shared.m_itemType)/*cast due to .constrained prefix*/).ToString()))
				.Append(';')
				.Append(Csv(item.Reason))
				.Append('\n');
		}
		AtomicWrite(Path.Combine(folder, "Catalog.csv"), stringBuilder.ToString());
	}

	private static string Csv(string s)
	{
		return "\"" + (s ?? "").Replace("\"", "\"\"") + "\"";
	}

	private static void AtomicWrite(string path, string content)
	{
		string text = path + ".tmp";
		File.WriteAllText(text, content, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true));
		if (File.Exists(path))
		{
			File.Replace(text, path, null);
		}
		else
		{
			File.Move(text, path);
		}
	}

