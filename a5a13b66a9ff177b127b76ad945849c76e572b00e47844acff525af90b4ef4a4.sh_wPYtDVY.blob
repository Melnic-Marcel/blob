namespace Noctyra.ItemUpgrader;

public static class GridWindow
{
	public static int PoolSize(double viewport, double rowStride, int columns)
	{
		return ((int)Math.Ceiling(viewport / rowStride) + 2) * columns;
	}

	public static int FirstIndex(double offset, double rowStride, int columns, int count)
	{
		int val = Math.Max(0, (int)Math.Floor(Math.Max(0.0, offset - 8.0) / rowStride) - 1);
		int val2 = Math.Max(0, (count + columns - 1) / columns - 1);
		return Math.Min(val, val2) * columns;
	}

	public static double ContentHeight(int count, int columns, double cellHeight, double gap)
	{
		if (count != 0)
		{
			return 16.0 + Math.Ceiling((double)count / (double)columns) * (cellHeight + gap) - gap;
		}
		return 16.0;
	}
}
public sealed class RewardReceipt
{
	public string Prefab;

	public int Amount = 1;

	public int Quality = 1;

	public string Transaction;
}
[BepInPlugin("noctyra.valheim.itemupgrader", "Noctyra Item Upgrader", "0.2.0")]
public sealed class Plugin : BaseUnityPlugin
{
	public const string Guid = "noctyra.valheim.itemupgrader";

	public const string Version = "0.2.0";

	private const string ReceiptKey = "noctyra.valheim.itemupgrader.pendingReward.v1";

	public static Plugin Instance;

	private static int closedFrame = -1;

	private ConfigEntry<KeyboardShortcut> hotkey;

	private ConfigEntry<bool> modEnabled;

	private ConfigEntry<double> returnRate;

	private ConfigEntry<double> maxChance;

	private ConfigEntry<double> craftingMarkup;

	private ConfigEntry<float> spinSeconds;

	private ConfigEntry<int> maximumRewardAmount;

	private Harmony harmony;

	private UpgraderUI ui;

	private Player player;

	private float refreshTime;

	private bool initialized;

	private bool invalidReceipt;

	private string catalogError;

	private RewardReceipt pending;

	private float spinStart;

	private float spinDuration;

	private double spinAngle;

	private double spinEndAngle;

	private double spinChance;

	private bool spinWin;

	private string spinTarget;

	public static bool IsOpen
	{
		get
		{
			if ((Object)(object)Instance != (Object)null && Instance.ui != null)
			{
				return Instance.ui.Visible;
			}
			return false;
		}
	}

	public static bool BlocksInput
	{
		get
		{
			if (!IsOpen)
			{
				return Time.frameCount == closedFrame;
			}
			return true;
		}
	}

	public ValueCatalog Catalog { get; private set; }

	public ItemData Source { get; private set; }

	public CatalogItem Target { get; private set; }

	public int Quantity { get; private set; }

	public int TargetQuantity { get; private set; }

	public int RewardRemaining
	{
		get
		{
			if (pending != null)
			{
				return pending.Amount;
			}
			return 0;
		}
	}

	public int MaximumRewardAmount => maximumRewardAmount.Value;

	public bool Spinning { get; private set; }

	public string Status { get; private set; }

	public bool HasReward => pending != null;

	public CatalogItem RewardItem
	{
		get
		{
			if (pending != null && Catalog != null)
			{
				return Catalog.Find(pending.Prefab);
			}
			return null;
		}
	}

	public Player LocalPlayer => player;

	public string HotkeyLabel => ((object)hotkey.Value/*cast due to .constrained prefix*/).ToString();

	public double Stake
	{
		get
		{
			if (Catalog != null)
			{
				return Catalog.StakeValue(Source, Quantity);
			}
			return 0.0;
		}
	}

	public double TargetTotal
	{
		get
		{
			if (Target != null)
			{
				return RollMath.TargetValue(Target.Value, TargetQuantity);
			}
			return 0.0;
		}
	}

	public double Chance => RollMath.Chance(Stake, TargetTotal, returnRate.Value, maxChance.Value);

	public double DisplayChance
	{
		get
		{
			if (!Spinning && (Source != null || !(spinAngle > 0.0)))
			{
				return Chance;
			}
			return spinChance;
		}
	}

	public bool CanChangeSelection
	{
		get
		{
			if (!Spinning && !HasReward)
			{
				return !invalidReceipt;
			}
			return false;
		}
	}

	public static void JustClosed()
	{
		closedFrame = Time.frameCount;
	}

	private void Awake()
	{
		//IL_0042: Unknown result type (might be due to invalid IL or missing references)
		//IL_0091: Unknown result type (might be due to invalid IL or missing references)
		//IL_009b: Expected O, but got Unknown
		//IL_00db: Unknown result type (might be due to invalid IL or missing references)
		//IL_00e5: Expected O, but got Unknown
		//IL_0125: Unknown result type (might be due to invalid IL or missing references)
		//IL_012f: Expected O, but got Unknown
		//IL_0163: Unknown result type (might be due to invalid IL or missing references)
		//IL_016d: Expected O, but got Unknown
		//IL_019d: Unknown result type (might be due to invalid IL or missing references)
		//IL_01a7: Expected O, but got Unknown
		//IL_01ff: Unknown result type (might be due to invalid IL or missing references)
		//IL_0209: Expected O, but got Unknown
		//IL_024d: Unknown result type (might be due to invalid IL or missing references)
		//IL_0252: Unknown result type (might be due to invalid IL or missing references)
		Instance = this;
		modEnabled = ((BaseUnityPlugin)this).Config.Bind<bool>("General", "Enabled", true, "Enable the local upgrader UI.");
		hotkey = ((BaseUnityPlugin)this).Config.Bind<KeyboardShortcut>("General", "OpenKey", new KeyboardShortcut((KeyCode)289, Array.Empty<KeyCode>()), "Key for opening and closing the upgrader.");
		returnRate = ((BaseUnityPlugin)this).Config.Bind<double>("Balance", "ReturnRate", 0.9, new ConfigDescription("Chance = stake value / target value * ReturnRate. No artificial minimum chance.", (AcceptableValueBase)(object)new AcceptableValueRange<double>(0.01, 1.0), Array.Empty<object>()));
		maxChance = ((BaseUnityPlugin)this).Config.Bind<double>("Balance", "MaximumChance", 0.95, new ConfigDescription("Maximum probability: 0.95 means 95%.", (AcceptableValueBase)(object)new AcceptableValueRange<double>(0.01, 1.0), Array.Empty<object>()));
		craftingMarkup = ((BaseUnityPlugin)this).Config.Bind<double>("Balance", "CraftingMarkup", 1.15, new ConfigDescription("Labor multiplier for automatically valued recipes. Existing ItemValues.json entries take precedence.", (AcceptableValueBase)(object)new AcceptableValueRange<double>(1.0, 3.0), Array.Empty<object>()));
		spinSeconds = ((BaseUnityPlugin)this).Config.Bind<float>("Visual", "SpinSeconds", 5f, new ConfigDescription("Wheel animation duration in seconds.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
		maximumRewardAmount = ((BaseUnityPlugin)this).Config.Bind<int>("Balance", "MaximumRewardAmount", 1000, new ConfigDescription("Maximum selected reward quantity. Larger rewards can be claimed in several batches.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(1, 10000), Array.Empty<object>()));
		ConfigEntry<string> val = ((BaseUnityPlugin)this).Config.Bind<string>("Internal", "AnimationVersion", "", "Tracks the one-time migration to the five-second animation.");
		if (val.Value != "0.2.0")
		{
			spinSeconds.Value = 5f;
			val.Value = "0.2.0";
		}
		harmony = new Harmony("noctyra.valheim.itemupgrader");
		harmony.PatchAll(typeof(Plugin).Assembly);
		Status = "Выбери ставку и желаемый предмет.";
		Quantity = 1;
		TargetQuantity = 1;
		((BaseUnityPlugin)this).Logger.LogInfo((object)("Noctyra Item Upgrader 0.2.0 loaded. Local only. Open with " + ((object)hotkey.Value/*cast due to .constrained prefix*/).ToString() + "."));
	}

	private void Update()
	{
		//IL_01ba: Unknown result type (might be due to invalid IL or missing references)
		//IL_01bf: Unknown result type (might be due to invalid IL or missing references)
		Player localPlayer = Player.m_localPlayer;
		if ((Object)(object)localPlayer != (Object)(object)player)
		{
			if (ui != null)
			{
				ui.Destroy();
			}
			ui = null;
			player = localPlayer;
			Source = null;
			Target = null;
			Quantity = 1;
			TargetQuantity = 1;
			Spinning = false;
			pending = null;
			invalidReceipt = false;
			spinAngle = 0.0;
			initialized = false;
			Catalog = null;
			catalogError = null;
		}
		if ((Object)(object)player == (Object)null)
		{
			return;
		}
		if (!modEnabled.Value)
		{
			if (ui != null && ui.Visible)
			{
				ui.Hide();
			}
			return;
		}
		if (!initialized && (Object)(object)ObjectDB.instance != (Object)null && ObjectDB.instance.m_items.Count > 0 && ObjectDB.instance.m_recipes.Count > 0 && !((Character)player).InCutscene())
		{
			Initialize();
		}
		if (!initialized)
		{
			return;
		}
		if (Spinning)
		{
			float num = Mathf.Clamp01((Time.unscaledTime - spinStart) / spinDuration);
			if (ui != null)
			{
				ui.SetAngle((float)(spinAngle * RollMath.SmoothSpin(num)));
			}
			if (num >= 1f)
			{
				if (ui != null)
				{
					ui.SetAngle((float)spinEndAngle);
				}
				CompleteSpin();
			}
		}
		if (ui != null && ui.Visible && ((Character)player).IsDead())
		{
			ui.Hide();
		}
		KeyboardShortcut value = hotkey.Value;
		if (((KeyboardShortcut)(ref value)).IsDown())
		{
			if (ui != null && ui.Visible)
			{
				ui.Hide();
			}
			else if (!((Character)player).IsDead() && !((Character)player).InCutscene() && !InventoryGui.IsVisible() && !Menu.IsVisible() && (!((Object)(object)Chat.instance != (Object)null) || !Chat.instance.HasFocus()))
			{
				Open();
			}
		}
		if (ui == null || !ui.Visible)
		{
			return;
		}
		if (Input.GetKeyDown((KeyCode)27))
		{
			ui.Hide();
			return;
		}
		Cursor.lockState = (CursorLockMode)0;
		Cursor.visible = true;
		if (Time.unscaledTime > refreshTime)
		{
			refreshTime = Time.unscaledTime + 0.35f;
			ValidateSource();
			ui.Refresh(force: false);
		}
	}

	private void Initialize()
	{
		try
		{
			Catalog = new ValueCatalog(Path.Combine(Paths.ConfigPath, "ItemUpgrader"), craftingMarkup.Value, ((BaseUnityPlugin)this).Logger);
			Catalog.Build();
			LoadReceipt();
			initialized = true;
			Status = (invalidReceipt ? "Ошибка сохранённой награды. Пришли LogOutput.log для исправления." : ((pending == null) ? "Выбери ставку и желаемый предмет." : "Есть сохранённый выигрыш. Нажми «Забрать»."));
			((MonoBehaviour)this).StartCoroutine(PrewarmUi(player));
		}
		catch (Exception ex)
		{
			initialized = true;
			Catalog = null;
			catalogError = "Ошибка таблицы ценностей. Проверь ItemValues.json и LogOutput.log.";
			((BaseUnityPlugin)this).Logger.LogError((object)("ItemUpgrader initialization failed: " + ex));
		}
	}

	private IEnumerator PrewarmUi(Player owner)
	{
		yield return null;
		if ((Object)(object)player != (Object)(object)owner || Catalog == null)
		{
			yield break;
		}
		try
		{
			if (ui == null)
			{
				ui = new UpgraderUI(this);
			}
		}
		catch (Exception ex)
		{
			((BaseUnityPlugin)this).Logger.LogError((object)("UI prewarm failed: " + ex));
			yield break;
		}
		UpgraderUI prepared = ui;
		IEnumerator steps = prepared.Prewarm();
		while ((Object)(object)player == (Object)(object)owner && ui == prepared && steps.MoveNext())
		{
			yield return steps.Current;
		}
	}

	private void Open()
	{
		if (Catalog == null)
		{
			((Character)player).Message((MessageType)2, catalogError ?? "Каталог ещё не готов.", 0, (Sprite)null, false);
			return;
		}
		try
		{
			if (ui == null)
			{
				ui = new UpgraderUI(this);
			}
			ValidateSource();
			ui.Show();
		}
		catch (Exception ex)
		{
			if (ui != null)
			{
				ui.Destroy();
			}
			ui = null;
			((BaseUnityPlugin)this).Logger.LogError((object)("Could not create upgrader UI: " + ex));
			((Character)player).Message((MessageType)2, "Не удалось открыть меню. Пришли LogOutput.log.", 0, (Sprite)null, false);
		}
	}

	public void SelectSource(ItemData item)
	{
		if (CanChangeSelection && item != null && ((Humanoid)player).GetInventory().ContainsItem(item))
		{
			if (item.m_equipped)
			{
				SetStatus("Сначала сними этот предмет с персонажа.");
				return;
			}
			if (Catalog.Find(item) == null)
			{
				SetStatus("Для этого предмета обмен отключён.");
				return;
			}
			Source = item;
			Quantity = 1;
			spinAngle = 0.0;
			ui.ResetWheel();
			Status = "Ставка выбрана. Выбери желаемый предмет справа.";
			ui.Refresh(force: true);
		}
	}

	public void SelectTarget(CatalogItem target)
	{
		if (CanChangeSelection && target != null)
		{
			Target = target;
			TargetQuantity = 1;
			spinAngle = 0.0;
			Status = "При проигрыше выбранное количество ставки исчезнет.";
			ui.ResetWheel();
			ui.Refresh(force: true);
		}
	}

	public void SetQuantity(int quantity)
	{
		if (CanChangeSelection && Source != null)
		{
			Quantity = Math.Max(1, Math.Min(Source.m_stack, quantity));
			ui.Refresh(force: false);
		}
	}

	public void SetTargetQuantity(int quantity)
	{
		if (CanChangeSelection && Target != null)
		{
			TargetQuantity = Math.Max(1, Math.Min(MaximumRewardAmount, quantity));
			spinAngle = 0.0;
			if (ui != null)
			{
				ui.ResetWheel();
				ui.Refresh(force: false);
			}
		}
	}

	public void ClearSource()
	{
		if (CanChangeSelection)
		{
			Source = null;
			Quantity = 1;
			spinAngle = 0.0;
			ui.ResetWheel();
			ui.Refresh(force: true);
		}
	}

	private void ValidateSource()
	{
		if (Source != null)
		{
			if ((Object)(object)player == (Object)null || !((Humanoid)player).GetInventory().ContainsItem(Source) || Source.m_equipped || Source.m_stack < 1)
			{
				Source = null;
				Quantity = 1;
			}
			else
			{
				Quantity = Math.Min(Quantity, Source.m_stack);
			}
		}
	}

	public bool CanRoll()
	{
		ValidateSource();
		if (modEnabled.Value && (Object)(object)player != (Object)null && !((Character)player).IsDead() && CanChangeSelection && Source != null && Target != null && Quantity >= 1)
		{
			return Chance > 0.0;
		}
		return false;
	}

	public void Roll()
	{
		if (!CanRoll())
		{
			return;
		}
		Inventory inventory = ((Humanoid)player).GetInventory();
		if (!inventory.ContainsItem(Source) || Source.m_stack < Quantity || Source.m_equipped)
		{
			SetStatus("Ставка изменилась. Выбери предмет заново.");
			return;
		}
		if ((Object)(object)ObjectDB.instance.GetItemPrefab(Target.Id) == (Object)null)
		{
			SetStatus("Желаемый предмет недоступен.");
			return;
		}
		double sample = UniformSample();
		double chance = Chance;
		bool flag = RollMath.Wins(sample, chance);
		string text = System.Guid.NewGuid().ToString("N");
		RewardReceipt rewardReceipt = (flag ? new RewardReceipt
		{
			Prefab = Target.Id,
			Amount = TargetQuantity,
			Quality = 1,
			Transaction = text
		} : null);
		string value = (flag ? JsonConvert.SerializeObject((object)rewardReceipt) : null);
		string name = ((Object)Source.m_dropPrefab).name;
		int quantity = Quantity;
		double stake = Stake;
		if (!inventory.RemoveItem(Source, quantity))
		{
			SetStatus("Не удалось списать ставку. Попытка отменена.");
			return;
		}
		pending = rewardReceipt;
		if (flag)
		{
			player.m_customData["noctyra.valheim.itemupgrader.pendingReward.v1"] = value;
		}
		else
		{
			player.m_customData.Remove("noctyra.valheim.itemupgrader.pendingReward.v1");
		}
		spinChance = chance;
		spinWin = flag;
		spinTarget = Target.Name + " × " + TargetQuantity;
		spinEndAngle = RollMath.EndAngle(sample);
		spinAngle = 2160.0 + spinEndAngle;
		spinStart = Time.unscaledTime;
		spinDuration = spinSeconds.Value;
		Spinning = true;
		Source = null;
		Quantity = 1;
		Status = "Колесо вращается…";
		((BaseUnityPlugin)this).Logger.LogInfo((object)("Upgrade " + text + ": " + name + " x" + quantity + " (" + stake.ToString("0.####", CultureInfo.InvariantCulture) + ") -> " + Target.Id + " x" + TargetQuantity + "; chance=" + RollMath.Percent(chance) + "; success=" + flag));
		if (ui != null)
		{
			ui.SetAngle(0f);
			ui.Refresh(force: true);
		}
	}

	private void CompleteSpin()
	{
		Spinning = false;
		Status = (spinWin ? ("УСПЕХ! «" + spinTarget + "» ждёт в ячейке результата.") : "Не повезло. Ставка сгорела. Можно попробовать снова.");
		if (ui != null)
		{
			ui.ShowResult(spinWin);
			ui.Refresh(force: true);
		}
	}

	public void Claim()
	{
		if (Spinning || pending == null || (Object)(object)player == (Object)null || ((Character)player).IsDead())
		{
			return;
		}
		if (pending.Amount < 1 || pending.Amount > 100000 || pending.Quality != 1)
		{
			SetStatus("Некорректная сохранённая награда. Пришли лог.");
			return;
		}
		GameObject itemPrefab = ObjectDB.instance.GetItemPrefab(pending.Prefab);
		ItemDrop val = (((Object)(object)itemPrefab == (Object)null) ? null : itemPrefab.GetComponent<ItemDrop>());
		if ((Object)(object)val == (Object)null)
		{
			SetStatus("Предмет награды отсутствует. Награда сохранена до его возвращения.");
			return;
		}
		Inventory inventory = ((Humanoid)player).GetInventory();
		int num = 0;
		while (pending.Amount > 0)
		{
			ItemData val2 = val.m_itemData.Clone();
			val2.m_dropPrefab = itemPrefab;
			val2.m_quality = 1;
			val2.m_equipped = false;
			val2.m_durability = val2.GetMaxDurability();
			int num2 = Math.Max(1, val2.m_shared.m_maxStackSize);
			long num3 = (long)Math.Max(0, inventory.GetWidth() * inventory.GetHeight() - inventory.GetAllItems().Count) * (long)num2;
			foreach (ItemData allItem in inventory.GetAllItems())
			{
				if (allItem.m_shared.m_name == val2.m_shared.m_name && allItem.m_quality == 1 && allItem.m_worldLevel == val2.m_worldLevel)
				{
					num3 += Math.Max(0, num2 - allItem.m_stack);
				}
			}
			int num4 = (int)Math.Min(pending.Amount, Math.Min(num2, num3));
			if (num4 < 1 || !inventory.CanAddItem(val2, num4))
			{
				break;
			}
			val2.m_stack = num4;
			bool num5 = inventory.AddItem(val2);
			int num6 = (num5 ? num4 : Math.Max(0, num4 - val2.m_stack));
			pending.Amount -= num6;
			num += num6;
			if (!num5)
			{
				break;
			}
		}
		if (pending.Amount == 0)
		{
			player.m_customData.Remove("noctyra.valheim.itemupgrader.pendingReward.v1");
			pending = null;
		}
		else
		{
			player.m_customData["noctyra.valheim.itemupgrader.pendingReward.v1"] = JsonConvert.SerializeObject((object)pending);
		}
		Status = ((num == 0) ? "Нет места. Освободи ячейки и нажми «Забрать»." : ((pending == null) ? ("Получено: " + num + " шт. Выбирай следующую ставку.") : ("Получено: " + num + " шт. Осталось забрать: " + pending.Amount + ".")));
		if (ui != null)
		{
			ui.Refresh(force: true);
		}
	}

	public void ReloadValues()
	{
		if (Spinning)
		{
			return;
		}
		try
		{
			string id = ((Target == null) ? null : Target.Id);
			ValueCatalog valueCatalog = new ValueCatalog(Path.Combine(Paths.ConfigPath, "ItemUpgrader"), craftingMarkup.Value, ((BaseUnityPlugin)this).Logger);
			valueCatalog.Build();
			Catalog = valueCatalog;
			Target = Catalog.Find(id);
			if (ui != null)
			{
				ui.RefreshCatalog();
			}
			SetStatus("Ценности перечитаны из ItemValues.json.");
		}
		catch (Exception ex)
		{
			((BaseUnityPlugin)this).Logger.LogError((object)("Price reload failed: " + ex));
			SetStatus("Ошибка JSON. Предыдущие цены сохранены.");
		}
	}

	private void LoadReceipt()
	{
		if (!player.m_customData.TryGetValue("noctyra.valheim.itemupgrader.pendingReward.v1", out var value))
		{
			return;
		}
		try
		{
			RewardReceipt rewardReceipt = JsonConvert.DeserializeObject<RewardReceipt>(value);
			if (rewardReceipt == null || string.IsNullOrEmpty(rewardReceipt.Prefab) || rewardReceipt.Amount < 1 || rewardReceipt.Amount > 100000 || rewardReceipt.Quality != 1)
			{
				throw new InvalidDataException("Invalid reward receipt");
			}
			pending = rewardReceipt;
		}
		catch (Exception ex)
		{
			invalidReceipt = true;
			((BaseUnityPlugin)this).Logger.LogError((object)("Pending reward data is invalid; further rolls blocked: " + ex));
		}
	}

	private static double UniformSample()
	{
		byte[] array = new byte[8];
		using (RandomNumberGenerator randomNumberGenerator = RandomNumberGenerator.Create())
		{
			randomNumberGenerator.GetBytes(array);
		}
		return (double)(BitConverter.ToUInt64(array, 0) >> 11) * 1.1102230246251565E-16;
	}

