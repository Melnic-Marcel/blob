hyGreydwarfBrute=100;TrophyGreydwarfShaman=100;TrophySkeleton=80;TrophySkeletonPoison=140;TrophyTroll=250;\nTrophySurtling=160;TrophyLeech=150;TrophyDraugr=150;TrophyDraugrElite=260;TrophyBlob=130;TrophyAbomination=450;TrophyWraith=320;\nTrophyWolf=250;TrophyHatchling=300;TrophyFenring=450;TrophyCultist=650;TrophySGolem=650;TrophySerpent=650;\nTrophyGoblin=320;TrophyGoblinBrute=800;TrophyGoblinShaman=650;TrophyDeathsquito=250;TrophyLox=650;TrophyGrowth=450;\nTrophySeeker=550;TrophySeekerBrute=1000;TrophyGjall=1200;TrophyHare=400;TrophyDvergr=700;\nTrophyMorgen=1800;TrophyAsksvin=1100;TrophyVolture=900;TrophyCharredMelee=850;TrophyCharredArcher=850;TrophyCharredMage=1200;TrophyBonemawSerpent=1700;TrophyFallenValkyrie=2600;\nTrophyEikthyr=600;TrophyTheElder=1500;TrophyBonemass=3000;TrophyDragonQueen=5000;TrophyGoblinKing=8000;TrophySeekerQueen=14000;TrophyFader=24000;\nFish1=16;Fish2=24;Fish3=32;Fish4_cave=90;Fish5=80;Fish6=65;Fish7=85;Fish8=75;Fish9=150;Fish10=180;Fish11=200;Fish12=120;\nFishRaw=14;FishingBaitForest=12;FishingBaitSwamp=20;FishingBaitMountain=30;FishingBaitPlains=35;FishingBaitMistlands=55;FishingBaitOcean=45;FishingBaitAshlands=75;FishingBaitDeepNorth=90;\nAcorn=12;FulingTotem=600;GoblinTotem=600;TornSpirit=2000;QueenDrop=6000;FaderDrop=10000;EikthyrDrop=180;HardAntler=180;DragonTear=1000;\nBushSeeds=6;VineberrySeeds=110;AsksvinEgg=450;AsksvinEggWarm=450;BogWitchKvastur=500;BogWitchRat=100;\n".Split(new char[3] { ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
		for (int i = 0; i < array.Length; i++)
		{
			string[] array2 = array[i].Trim().Split('=');
