public static class RollMath
{
	public static double Chance(double stake, double target, double returnRate, double maximum)
	{
		if (!FinitePositive(stake) || !FinitePositive(target))
		{
			return 0.0;
		}
		if (!FinitePositive(returnRate) || !FinitePositive(maximum))
		{
			return 0.0;
		}
		return Math.Min(Math.Min(maximum, 1.0), stake / target * Math.Min(returnRate, 1.0));
	}

	public static bool FinitePositive(double value)
	{
		if (value > 0.0 && !double.IsInfinity(value))
		{
			return !double.IsNaN(value);
		}
		return false;
	}

	public static bool Wins(double sample, double chance)
	{
		if (sample >= 0.0 && sample < 1.0)
		{
			return sample < chance;
		}
		return false;
	}

	public static double EndAngle(double sample)
	{
		return sample * 360.0;
	}

	public static double TargetValue(double unitValue, int amount)
	{
		if (amount <= 0 || !FinitePositive(unitValue))
		{
			return 0.0;
		}
		return unitValue * (double)amount;
	}

	public static double SmoothSpin(double t)
	{
		t = Math.Max(0.0, Math.Min(1.0, t));
		if (t < 0.12)
		{
			return 0.5 * (t - 3.0 / (25.0 * Math.PI) * Math.Sin(Math.PI * t / 0.12)) / 0.62;
		}
		double num = 0.06;
		if (t < 0.36)
		{
			return (num + t - 0.12) / 0.62;
		}
		double num2 = t - 0.36;
		double num3 = 0.64;
		return (num + 0.36 - 0.12 + 0.5 * (num2 + num3 / Math.PI * Math.Sin(Math.PI * num2 / num3))) / 0.62;
	}

	public static string Percent(double chance)
	{
		double num = chance * 100.0;
		if (num >= 0.01)
		{
			return num.ToString("0.00", CultureInfo.InvariantCulture) + "%";
		}
		if (num > 0.0)
		{
			return num.ToString("0.########", CultureInfo.InvariantCulture) + "%";
		}
		return "0%";
	}
}
