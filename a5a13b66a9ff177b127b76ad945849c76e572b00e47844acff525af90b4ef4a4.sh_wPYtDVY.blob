			claimLabel.text = "ЗАБРАТЬ × " + plugin.RewardRemaining;
			((Component)targetQuantityGroup).gameObject.SetActive(!((Component)claim).gameObject.activeSelf);
			bool canChangeSelection = plugin.CanChangeSelection;
			((Selectable)targetMinus).interactable = canChangeSelection && plugin.Target != null && plugin.TargetQuantity > 1;
			((Selectable)targetPlus).interactable = canChangeSelection && plugin.Target != null && plugin.TargetQuantity < plugin.MaximumRewardAmount;
			((Selectable)targetQuantity).interactable = canChangeSelection && plugin.Target != null;
			if (!targetQuantity.isFocused)
			{
				targetQuantity.SetTextWithoutNotify(plugin.TargetQuantity.ToString());
			}
			((Selectable)minus).interactable = canChangeSelection && source != null && plugin.Quantity > 1;
			((Selectable)plus).interactable = canChangeSelection && source != null && plugin.Quantity < source.m_stack;
			((Selectable)all).interactable = canChangeSelection && source != null && plugin.Quantity < source.m_stack;
			((Selectable)clear).interactable = canChangeSelection && source != null;
			((Selectable)roll).interactable = plugin.CanRoll();
			rollLabel.text = (plugin.Spinning ? "ВРАЩАЕТСЯ…" : (plugin.HasReward ? "ЗАБЕРИ ВЫИГРЫШ" : "УЛУЧШИТЬ"));
			((Selectable)reload).interactable = !plugin.Spinning;
			status.text = plugin.Status;
			((Graphic)status).color = ((plugin.HasReward && !plugin.Spinning) ? Green : Muted);
			double displayChance = plugin.DisplayChance;
			percent.text = ((displayChance <= 0.0) ? "—" : RollMath.Percent(displayChance));
			if (percent.text.Length > 8)
			{
				percent.fontSize = 17;
			}
			else
			{
				percent.fontSize = 29;
			}
			wheel.SetChance((float)displayChance);
			if (!plugin.Spinning && source != null)
			{
				wheel.ClearResult();
			}
			RebuildInventory();
			if (!catalogBound)
			{
				RebuildTargets();
			}
			else
			{
				UpdateVisibleTargets();
			}
		}
	}

	public void RefreshCatalog()
	{
		inventoryStamp = int.MinValue;
		RebuildTargets();
		Refresh(force: false);
	}

	public IEnumerator Prewarm()
	{
		int targetCount = GridWindow.PoolSize(214.0, 96.0, 4);
		int inventoryCount = ((Humanoid)plugin.LocalPlayer).GetInventory().GetAllItems().Count;
		while (targetCards.Count < targetCount)
		{
			for (int i = 0; i < 4; i++)
			{
				if (targetCards.Count >= targetCount)
				{
					break;
				}
				targetCards.Add(CreateCard(target: true));
			}
			yield return null;
		}
		while (inventoryCards.Count < inventoryCount)
		{
			for (int j = 0; j < 4; j++)
			{
				if (inventoryCards.Count >= inventoryCount)
				{
					break;
				}
				inventoryCards.Add(CreateCard(target: false));
			}
			yield return null;
		}
		Refresh(force: false);
		int[] array = new int[4] { 10, 11, 15, 29 };
		foreach (int num in array)
		{
			font.RequestCharactersInTexture("АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789×%—.,:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", num);
			yield return null;
		}
	}

	private void RebuildInventory()
	{
		//IL_0148: Unknown result type (might be due to invalid IL or missing references)
		//IL_0236: Unknown result type (might be due to invalid IL or missing references)
		//IL_021b: Unknown result type (might be due to invalid IL or missing references)
		if ((Object)(object)plugin.LocalPlayer == (Object)null)
		{
			return;
		}
		List<ItemData> allItems = ((Humanoid)plugin.LocalPlayer).GetInventory().GetAllItems();
		int num = 17;
		foreach (ItemData item in allItems)
		{
			num = num * 31 + ((object)item).GetHashCode();
			num = num * 31 + item.m_stack;
			num = num * 31 + item.m_quality;
			num = num * 31 + item.m_durability.GetHashCode();
			num = num * 31 + ((object)Unsafe.As<Vector2i, Vector2i>(ref item.m_gridPos)/*cast due to .constrained prefix*/).GetHashCode();
			num = num * 31 + (item.m_equipped ? 1 : 0);
		}
		if (num != inventoryStamp)
		{
			inventoryStamp = num;
			inventoryItems = (from i in allItems
				orderby i.m_gridPos.y, i.m_gridPos.x
				select i).ToList();
			inventoryContent.sizeDelta = new Vector2(0f, (float)GridWindow.ContentHeight(inventoryItems.Count, 8, 66.0, 4.0));
		}
		while (inventoryCards.Count < inventoryItems.Count)
		{
			inventoryCards.Add(CreateCard(target: false));
		}
		for (int num2 = 0; num2 < inventoryCards.Count; num2++)
		{
			CardView cardView = inventoryCards[num2];
			if (num2 >= inventoryItems.Count)
			{
				((Component)cardView.Root).gameObject.SetActive(false);
				continue;
			}
			ItemData val = inventoryItems[num2];
			((Component)cardView.Root).gameObject.SetActive(true);
			cardView.Item = val;
			Position(cardView.Root, num2, 8, 57, 66);
			cardView.Icon.sprite = val.GetIcon();
			((Graphic)cardView.Icon).color = (Color)(val.m_equipped ? new Color(0.7f, 0.7f, 0.7f, 1f) : Color.white);
			cardView.First.text = "×" + val.m_stack;
			cardView.Second.text = (val.m_equipped ? "●" : "");
			cardView.Tooltip = Name(val) + "  ·  ценность 1 шт.: " + Number(plugin.Catalog.StakeValue(val, 1)) + (val.m_equipped ? "  ·  сначала сними" : "");
			((Selectable)cardView.Button).interactable = plugin.CanChangeSelection && !val.m_equipped && plugin.Catalog.Find(val) != null;
			cardView.SetSelected(plugin.Source == val);
		}
	}

	private void CycleCategory()
	{
		filter = (filter + 1) % 4;
		categoryLabel.text = (new string[4] { "Все", "Снаряжение", "Ресурсы", "Еда / зелья" })[filter];
		catalogScroll.verticalNormalizedPosition = 1f;
		RebuildTargets();
	}

	private bool MatchesFilter(CatalogItem entry)
	{
		string text = ((object)Unsafe.As<ItemType, ItemType>(ref entry.Template.m_shared.m_itemType)/*cast due to .constrained prefix*/).ToString();
		if (filter == 1)
		{
			if (!text.Contains("Weapon"))
			{
				switch (text)
				{
				default:
					return text == "Trinket";
				case "Bow":
				case "Shield":
				case "Helmet":
				case "Chest":
				case "Legs":
				case "Shoulder":
				case "Utility":
				case "Tool":
					break;
				}
			}
			return true;
		}
		if (filter == 2)
		{
			if (!(text == "Material") && !(text == "Trophy"))
			{
				return text == "Misc";
			}
			return true;
		}
		if (filter == 3)
		{
			if (!(text == "Consumable"))
			{
				return text == "Fish";
			}
			return true;
		}
		return true;
	}

	private void RebuildTargets()
	{
		//IL_00f9: Unknown result type (might be due to invalid IL or missing references)
		//IL_0109: Unknown result type (might be due to invalid IL or missing references)
		if (plugin.Catalog == null || (Object)(object)catalogContent == (Object)null)
		{
			return;
		}
		string text = (((Object)(object)search == (Object)null) ? "" : search.text.Trim());
		matches.Clear();
		foreach (CatalogItem item in plugin.Catalog.Items)
		{
			if (MatchesFilter(item) && (text.Length == 0 || item.Name.IndexOf(text, StringComparison.CurrentCultureIgnoreCase) >= 0 || item.Id.IndexOf(text, StringComparison.OrdinalIgnoreCase) >= 0))
			{
				matches.Add(item);
			}
		}
		catalogBound = true;
		catalogContent.sizeDelta = new Vector2(0f, (float)GridWindow.ContentHeight(matches.Count, 4, 92.0, 4.0));
		catalogContent.anchoredPosition = Vector2.zero;
		catalogScroll.StopMovement();
		int num = GridWindow.PoolSize(214.0, 96.0, 4);
		while (targetCards.Count < num)
		{
			targetCards.Add(CreateCard(target: true));
		}
		catalogCount.text = matches.Count + " / " + plugin.Catalog.Items.Count + " предметов";
		UpdateVisibleTargets();
	}

	private void UpdateVisibleTargets()
	{
		//IL_0006: Unknown result type (might be due to invalid IL or missing references)
		int num = GridWindow.FirstIndex(catalogContent.anchoredPosition.y, 96.0, 4, matches.Count);
		for (int i = 0; i < targetCards.Count; i++)
		{
			CardView cardView = targetCards[i];
			int num2 = num + i;
			if (num2 >= matches.Count)
			{
				((Component)cardView.Root).gameObject.SetActive(false);
				cardView.Entry = null;
				continue;
			}
			CatalogItem catalogItem = matches[num2];
			((Component)cardView.Root).gameObject.SetActive(true);
			if (cardView.Index != num2)
			{
				Position(cardView.Root, num2, 4, 116, 92);
				cardView.Index = num2;
			}
			if (cardView.Entry != catalogItem)
			{
				cardView.Entry = catalogItem;
				cardView.Icon.sprite = catalogItem.Template.GetIcon();
				cardView.First.text = catalogItem.Name;
				cardView.Second.text = Number(catalogItem.Value);
				cardView.Tooltip = catalogItem.Name + "  ·  " + catalogItem.Id + "  ·  ценность: " + Number(catalogItem.Value);
			}
			((Selectable)cardView.Button).interactable = plugin.CanChangeSelection;
			cardView.SetSelected(plugin.Target == catalogItem);
		}
	}

